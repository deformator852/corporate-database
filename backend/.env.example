# `uv run setup` fills empty or weak secrets with random values.
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_NAME=
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
APP_LANGUAGE=en
EMBEDING_MODEL=multilingual-e5-base
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=
MINIO_ENDPOINT=localhost:9000
# Root: MinIO admin only. Access/secret key: the app user (bucket objects only).
# `uv run setup` fills empty values with random ones.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=documents
MINIO_SECURE=false
JWT_SECRET_KEY=
LLM_HOST=http://127.0.0.1:11434
LLM_MODEL=llama3.1:8b
# true only on development machines: exposes /docs and /openapi.json.
API_DOCS=false
# HTTPS proxy (docker-compose.prod.yml, deploy/Caddyfile).
SITE_ADDRESS=localhost
TLS=internal
