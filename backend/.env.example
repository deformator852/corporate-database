# `uv run setup` fills empty or weak secrets with random values.
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_NAME=
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
APP_LANGUAGE=en
EMBEDING_MODEL=multilingual-e5-base
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=
MINIO_ENDPOINT=localhost:9000
# Root: MinIO admin only. Access/secret key: the app user (bucket objects only).
# `uv run setup` fills empty values with random ones.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=documents
MINIO_SECURE=false
# MinIO's default; set only if the server runs with another MINIO_REGION.
MINIO_REGION=us-east-1
JWT_SECRET_KEY=
LLM_HOST=http://127.0.0.1:11434
LLM_MODEL=llama3.1:8b
# Tokens of context per chat request; larger = more document text, more RAM.
LLM_NUM_CTX=16384
# Searchable piece of a document, in characters, and the text repeated between
# neighbouring pieces. Smaller (400/80): exact facts ("amount in clause 3.2"),
# ~2x disk. Larger (1200/200): topic questions, less disk. Keep chunks within
# the embedding model's input (uv run configure shows it). New uploads only.
CHUNK_SIZE=800
CHUNK_OVERLAP=150
# Cleanup of chunk text before embedding: llm (rules, then LLM rewrite),
# rules (rules only) or off. The original text is always kept for answers.
TEXT_CLEANUP=llm
# LLM cleanup seconds per document; chunks past it get rules only.
TEXT_CLEANUP_BUDGET_SECONDS=480
# true only on development machines: exposes /docs and /openapi.json.
API_DOCS=false
# HTTPS proxy (docker-compose.prod.yml, deploy/Caddyfile).
SITE_ADDRESS=localhost
TLS=internal
# Saved chats idle this many days are deleted (0 keeps them forever).
CHAT_RETENTION_DAYS=90
