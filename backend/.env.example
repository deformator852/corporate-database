# Corpus settings. `uv run setup` fills empty or weak secrets with random
# values. Each process reads this file when it starts: after a change, restart
# the backend and the worker (on a server: deploy/deploy.sh up).

# --- Database (Postgres) ---
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_NAME=

# --- Search index (Qdrant) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# --- Language and search model ---
# System language for the interface and the answers: en, es or fr.
APP_LANGUAGE=en
EMBEDDING_MODEL=multilingual-e5-base

# --- Queue (RabbitMQ) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# --- File storage (MinIO) ---
MINIO_ENDPOINT=localhost:9000
# The root account administers MinIO only. The app uses MINIO_ACCESS_KEY and
# MINIO_SECRET_KEY, an account that can only read and write bucket objects.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=documents
MINIO_SECURE=false
# Change only if the MinIO server runs with another MINIO_REGION.
MINIO_REGION=us-east-1

# --- Sessions and encryption ---
JWT_SECRET_KEY=
# Encrypts documents and chats at rest. Without it they cannot be read: store
# a copy outside the server. Never change it by hand; use
# `uv run setup key rotate`, which sets DATA_ENCRYPTION_KEY_PREVIOUS until the
# re-encryption finishes. `uv run setup key` shows its fingerprint.
DATA_ENCRYPTION_KEY=

# --- AI model (Ollama) ---
LLM_HOST=http://127.0.0.1:11434
LLM_MODEL=llama3.1:8b
# Tokens of context per chat request. More context sends more document text
# to the model and needs more memory.
LLM_NUM_CTX=16384
# Answers the model writes at the same time. Each one needs its own context
# memory; `uv run configure` shows how much. Applies when Ollama restarts.
LLM_PARALLEL=4

# --- Document processing ---
# Size of a searchable piece of a document, in characters, and the text
# repeated between neighbouring pieces. Smaller pieces (400/80) find exact
# facts, such as an amount in clause 3.2, and use about twice the disk. Larger
# pieces (1200/200) suit topic questions and use less disk. Keep pieces within
# the input size of the search model; `uv run configure` shows it. A change
# applies to documents uploaded afterwards.
CHUNK_SIZE=800
CHUNK_OVERLAP=150
# How text is cleaned before it is indexed: llm (rules, then an AI rewrite),
# rules (rules only) or off. Answers always use the original text.
TEXT_CLEANUP=llm
# Seconds of AI cleanup per document. Pieces after this time get rules only.
TEXT_CLEANUP_BUDGET_SECONDS=480

# --- Chat ---
# Saved chats idle for this many days are deleted. 0 keeps them forever.
CHAT_RETENTION_DAYS=90
# Questions one user can ask in any 10 minutes. 0 turns the limit off. Each
# user always gets one answer at a time.
CHAT_QUESTIONS_PER_10_MIN=20

# --- Web server (docker-compose.prod.yml, deploy/Caddyfile) ---
SITE_ADDRESS=localhost
TLS=internal
# Set to true only on development machines: it exposes /docs and /openapi.json.
API_DOCS=false
