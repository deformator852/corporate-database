# Corpus settings. `uv run setup` fills empty or weak secrets with random
# values. Each process reads this file when it starts: after a change, restart
# the backend and the worker (on a server: deploy/deploy.sh up).

# --- Database (Postgres) ---
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_NAME=

# --- Search index (Qdrant) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# --- Language and search model ---
# Default language of the interface and the answers: en, es or fr.
APP_LANGUAGE=en
# Multilingual: the languages users switch between in the header, comma
# separated (for example en,es,fr). Each user reads the interface, errors,
# notices and answers in their choice. Needs a multilingual embedding model.
# Unset: only APP_LANGUAGE.
APP_LANGUAGES=en
EMBEDDING_MODEL=multilingual-e5-base

# --- Queue (RabbitMQ) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# --- Document files ---
# Where uploaded files are kept, encrypted: disk (this server: the
# documents_data volume in production, STORAGE_DIR in development) or s3 (the
# company's own S3-compatible storage). Set by `uv run setup` / `configure`.
# Switching in `uv run configure` offers to move the files already uploaded.
STORAGE=disk
# Development only, relative to backend/; production uses the volume.
STORAGE_DIR=storage
# STORAGE=s3: http(s)://host[:port] without a path, a bucket that exists, and
# an account allowed only s3:GetObject, s3:PutObject, s3:DeleteObject on it.
# S3_ENDPOINT=https://s3.company.local
# S3_BUCKET=corpus-documents
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1
# CA file of the storage's certificate when a company CA signed it.
# S3_CACERT=

# --- Sessions and encryption ---
JWT_SECRET_KEY=
# Encrypts documents and chats at rest. Without it they cannot be read: store
# a copy outside the server. Never change it by hand; use
# `uv run setup key rotate`, which sets DATA_ENCRYPTION_KEY_PREVIOUS until the
# re-encryption finishes. `uv run setup key` shows its fingerprint.
DATA_ENCRYPTION_KEY=
# Where the key is kept: env (above) or vault (HashiCorp Vault; then the key is
# not in this file). Choose it in `uv run setup` or `uv run configure`, which
# fill these and move the key; see documentations/deployment.md.
# KEY_STORE=env
# VAULT_ADDR=https://vault.example.com:8200
# VAULT_ROLE_ID=
# VAULT_SECRET_ID=
# VAULT_KV_MOUNT=secret
# VAULT_KV_PATH=corpus
# VAULT_CACERT=

# --- AI model (Ollama) ---
LLM_HOST=http://127.0.0.1:11434
LLM_MODEL=llama3.1:8b
# Tokens of context per chat request. More context sends more document text
# to the model and needs more memory.
LLM_NUM_CTX=16384
# Answers the model writes at the same time. Each one needs its own context
# memory; `uv run configure` shows how much. Applies when Ollama restarts.
LLM_PARALLEL=4

# --- Document processing ---
# Size of a searchable piece of a document, in characters, and the text
# repeated between neighbouring pieces. Smaller pieces (400/80) find exact
# facts, such as an amount in clause 3.2, and use about twice the disk. Larger
# pieces (1200/200) suit topic questions and use less disk. Keep pieces within
# the input size of the search model; `uv run configure` shows it. A change
# applies to documents uploaded afterwards.
CHUNK_SIZE=800
CHUNK_OVERLAP=150
# How text is cleaned before it is indexed for search: rules (drops page
# headers and footers, page numbers, separators) or off. Search results and
# answers always show the original text.
TEXT_CLEANUP=rules

# --- Chat ---
# Saved chats idle for this many days are deleted. 0 keeps them forever.
CHAT_RETENTION_DAYS=90
# Questions one user can ask in any 10 minutes. 0 turns the limit off. Each
# user always gets one answer at a time.
CHAT_QUESTIONS_PER_10_MIN=20

# --- Sign-in ---
# Single sign-on (OpenID Connect) with the company's identity provider; set
# by uv run setup / configure. Empty OIDC_ISSUER: SSO is off. With SSO on,
# only administrators sign in with a Corpus password.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# This server's callback, registered at the provider.
OIDC_REDIRECT_URI=https://corpus.example.com/api/v1/auth/sso/callback
# "Sign in with NAME".
OIDC_NAME=Microsoft
OIDC_GROUPS_CLAIM=groups
# Provider group to role key, ';' between pairs: Corpus Admins=admin;Legal=legal
OIDC_ROLE_MAP=
# on: a first SSO sign-in takes over the Corpus account with the same email.
OIDC_LINK_BY_EMAIL=off

# --- Error log ---
# Warnings and errors older than this many days are deleted. 0 keeps them
# forever.
ERROR_LOG_RETENTION_DAYS=30

# --- Web server (docker-compose.prod.yml, deploy/Caddyfile) ---
SITE_ADDRESS=localhost
TLS=internal
# Set to true only on development machines: it exposes /docs and /openapi.json.
API_DOCS=false
